{
  "manifest_version": 3,
  "name": "GitHub Design Task Tracker",
  "version": "1.0.0",
  "description": "Track your design work progress on GitHub issues without changing their status",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/issues*",
        "https://github.com/*/issues*"
      ],
      "js": [
        "list-view-tracker.js"
      ]
    }
  ],
  "icons": {
    "16": "/icons/icon-16.png",
    "48": "/icons/icon-48.png",
    "128": "/icons/icon-128.png"
  },
  "action": {
    "default_title": "Design Task Tracker",
    "default_popup": "popup.html"
  }
}
